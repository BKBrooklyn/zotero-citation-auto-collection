{
  "manifest_version": 2,
  "name": "Citation Auto-Collection",
  "version": "1.0.1",
  "description": "Keeps a chosen Zotero collection in sync with references cited in Word.",
  "author": "Brooklyn Liu",
  "homepage_url": "https://github.com/BKBrooklyn/zotero-citation-auto-collection",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "applications": {
    "zotero": {
      "id": "citation-auto-collection@bkbrooklyn.github.io",
      "update_url": "https://updates.invalid/citation-auto-collection/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
